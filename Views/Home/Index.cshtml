@{
    ViewData["Title"] = "Welcome to RaceBay";
}

<div class="hero-section text-center shadow-lg">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">Push Your Limits.</h1>
        <p class="lead fs-4 mb-4">Find, enroll, and track your performance in the best races in the country.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-5">Join Now</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-5">Login</a>
        </div>
    </div>
</div>

<div class="row text-center mb-5">
    <div class="col-md-4 mb-3">
        <div class="card h-100 p-4">
            <div class="card-body">
                <h5 class="fw-bold">🏃 Find Races</h5>
                <p class="text-muted">Browse upcoming events filtered by distance and location.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100 p-4">
            <div class="card-body">
                <h5 class="fw-bold">🎟️ Easy Enrollment</h5>
                <p class="text-muted">Register for events with a single click and track your status.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card h-100 p-4">
            <div class="card-body">
                <h5 class="fw-bold">🏆 Track Results</h5>
                <p class="text-muted">See your finish times, overall positions, and personal race history.</p>
            </div>
        </div>
    </div>
</div>