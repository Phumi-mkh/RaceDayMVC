@model List<RaceBay.MVC.Models.Dto.CategoryDto>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="row">
    <div class="col-md-8">
        <h2 class="fw-bold mb-4">Categories</h2>
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover bg-white mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Category Name</th>
                        <th>Distance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="align-middle fw-bold">@cat.Name</td>
                            <td class="align-middle">@cat.Distance</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 mt-5">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Add New Category</h5>
                <form asp-action="CreateCategory" method="post">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Distance</label>
                        <input name="Distance" class="form-control" placeholder="e.g. 42.2km" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add Category</button>
                </form>
            </div>
        </div>
    </div>
</div>