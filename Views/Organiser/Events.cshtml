@model List<RaceBay.MVC.Models.Dto.EventDto>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Manage Events</h2>
    <a asp-action="CreateEvent" class="btn btn-primary">➕ Create Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover bg-white mb-0">
        <thead class="table-dark">
            <tr>
                <th>Banner</th>
                <th>Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" alt="Banner" style="height: 50px; border-radius: 4px;" />
                        }
                        else
                        {
                            <span class="text-muted small">No Image</span>
                        }
                    </td>
                    <td class="align-middle fw-bold">@ev.Name</td>
                    <td class="align-middle">@ev.Date.ToString("MMM dd, yyyy")</td>
                    <td class="align-middle">@ev.Location</td>
                    <td>
                        <a asp-action="EditEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Enrollments" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-info">Participants</a>
                        <form asp-action="DeleteEvent" asp-route-id="@ev.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>