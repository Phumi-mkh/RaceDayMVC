@model RaceBay.MVC.Models.Dto.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Organiser Dashboard</h2>
    <a asp-action="CreateEvent" class="btn btn-success">➕ Create New Event</a>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3 shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">Total Events</h5>
                <p class="card-text display-4">@Model.TotalEvents</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3 shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">Total Enrollments</h5>
                <p class="card-text display-4">@Model.TotalEnrollments</p>
            </div>
        </div>
    </div>
</div>

<h4 class="mb-3">Upcoming Events</h4>
@if (!Model.UpcomingEvents.Any())
{
    <div class="alert alert-info">No upcoming events found.</div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover bg-white mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.UpcomingEvents)
                {
                    <tr>
                        <td class="align-middle fw-bold">@ev.Name</td>
                        <td class="align-middle">@ev.Date.ToString("MMM dd, yyyy")</td>
                        <td class="align-middle">@ev.Location</td>
                        <td>
                            <a asp-action="Enrollments" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-primary">Enrollments</a>
                            <a asp-action="EnterResults" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-success">Results</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}